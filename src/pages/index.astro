---
import { Image } from 'astro:assets'
import daniel from '../assets/Daniel_Kause-Fotograf-1000px.jpg'
import BaseLayout from '../layouts/BaseLayout.astro'
import CTA from '../components/CTA.astro'
import Testimonial from '../components/testimonial.astro'
import { getCollection } from 'astro:content'

const testimonials = await getCollection('testimonials')
const davidTestimonial = testimonials.find((t) => t.id === 'david-hamann')
---

<BaseLayout
  title="Daniel Kause - Webentwicklung und UX Design | Silberblick "
  description="Webseiten, schnell und barrierefrei, die von Suchmaschinen gefunden und Ihnen Kunden bringen"
>
  <section class="grid">
    <div>
      <h1>SILBERBLICK<br /> <span style="font-size: 0.5em;">Klären. Entwickeln. Veredeln.</span></h1>

      <p>
        Ich bin Daniel Kause – Fotografenmeister, UX-Designer und Full-Stack-Entwickler. Ich fotografiere und baue
        Webseiten und Designsysteme für Firmen, Solo-Selbstständige und Organisationen.<br /><strong>
          Ästhetisch, barrierefrei und sicher.
        </strong>
      </p>
      <CTA />
      <p>
        Zu meinen Kunden gehören Einzelunternehmer, wie der Historiker David Hamann, für den ich eine komplett neue
        WordPress Webseite mit eigenem Template entwickelt habe. Oder die SMartde eG, deren WordPress Webseite ich mit
        kleinen Fixes, Plugin-Updates, Sicherheits- und Barrierefreiheitsaudits warte.
      </p>
    </div>
    <div id="wobble" data-src={daniel.src}>
      <Image src={daniel} alt="Daniel Kause, Fotograf und Webentwickler" />
    </div>
  </section>
  <section id="kause">
    <h2>Meine Methode</h2>
    <article>
      <h3>Klären</h3><p>
        Als UX-Designer stelle ich den Menschen in den Mittelpunkt der Entwicklung einer Webseite.<a
          >Klicken Sie hier und erfahren, wie ich mit einer kleinen Nutzerbasis Daten für die Entwicklung der Website
          von Dr. Hamann gewonnen habe.</a
        >
      </p>
    </article>
    <article>
      <h3>Entwickeln</h3><p>
        Ich verwende weder Buzzwords wie AI oder KI oder Fachjargon und hinterfrage aktuelle technische Trends und
        Methoden, lege Wert auf eine direkte Kommunikation. Auf der Webseite und in Projekten.
      </p>
    </article>
    <article>
      <h3>Veredeln</h3>
      <p>
        Ich bringe Erfahrung aus über 25 Jahren Selbständigkeit als Fotografenmeister im eigenen Studio mit, inkl.
        Ausbildung einer Fotografin und einer Insolvenz in Eigenverwaltung durchgeführt.
      </p>
    </article>
    <div>
      <CTA />
    </div>
  </section>
</BaseLayout>
<script>
  import { initMovingCells } from '../scripts/moving-cells'

  let instance: ReturnType<typeof initMovingCells> | null = null

  function setup() {
    if (instance) instance.destroy()
    const container = document.getElementById('wobble')
    if (!container) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      container.classList.add('static')
      return
    }
    instance = initMovingCells(container)
  }
  function cleanup() {
    if (instance) {
      instance.destroy()
      instance = null
    }
  }
  document.addEventListener('astro:page-load', setup)
  document.addEventListener('astro:before-swap', cleanup)
</script>

<style>
  #wobble {
    max-width: min(100%, 500px);
    aspect-ratio: 1;
    flex-shrink: 0;
    align-self: flex-start;
  }

  #wobble img {
    display: none;
  }

  #wobble.static img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #wobble canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
