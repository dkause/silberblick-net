---
import { Image } from 'astro:assets'
import daniel from '../assets/Daniel_Kause-Fotograf-1000px.jpg'
import david from '../assets/Foto-David-Hamann.jpg'
import LandingPageLayout from '../layouts/BaseLayout.astro'
import CTA from '../components/CTA.astro'
import Testimonial from '../components/testimonial.astro'
---

<LandingPageLayout
  title="Daniel Kause - Webentwicklung und UX Design | Silberblick "
  description="Webseiten, schnell und barrierefrei, die von Suchmaschinen gefunden und Ihnen Kunden bringen"
  landing
>
  <section class="grid">
    <div id="wobble" data-src={daniel.src}>
      <Image src={daniel} alt="Portraitfoto Daniel Kause" />
    </div>
    <article class="hero">
      <h1>
        Webseiten, die für Sie arbeiten.<strong
          >Nicht Sie für die Webseite.</strong
        >
      </h1>
      <p>
        Ich bin <a href="/kause-biografie">Daniel Kause</a> und Silberblick ist meine
        "Ein-Mensch-Agentur" und baut mit Firmen, <a
          href="/referenzen/wordpress-relaunch">Solo-Selbständigen</a
        > und <a href="/referenzen/#SMartde">Organisationen</a> Webseiten, die Kunden
        gewinnen, schnell und barrierefrei sind und von Suchmaschinen gefunden werden.
        <br />Wollen Sie mit mir zusammenarbeiten, dann beschreiben Sie mir in
        einer E-Mail kurz das Projekt.
      </p>
      <CTA />
    </article>
  </section>
  <section class="grid" id="social-proof">
    <h2 style="display: block">Das sagen Kunden:</h2>
    <Testimonial
      title="Recherche Dienste"
      blockquote="Die neue Seite hat bereits nach wenigen Tagen online neue Anfragen aus Japan generiert."
      cite="Dr. David Hamann - Recherche-Dienste"
      image={david}
      imageAlt="Portrait Dr. david Hamann"
    />
    <section style="display: none">
      <h3>SMartde.coop</h3>
      <blockquote>
        <p>
          Die Seite ist viel klarer und barrierefrei und die Zusammenarbeit
          reibungslos.
        </p>
      </blockquote>
      <cite> Magda Ziomek- Geschäftsführerin SMartde.coop</cite>
    </section>
  </section>
  <section id="services" style="--stack-space: 3rem" class="grid-grid">
    <article>
      <h1>Nutzen</h1>
      <p>
        <strong>Mensch im Mittelpunkt!</strong><br />
        Die Psychologie des Nutzers bestimmt den Erfolg Ihrer Website. Mit Methode
        und System zur richtigen UX-Strategie, die hohe Usability und Geschäftsziele
        zusammenbringt.
      </p>
      <ul class="stack-half">
        <li><a href="/webseiten/ux-strategie">UX Strategie</a></li>
        <li>Informationsarchitektur</li>
        <li>Design-Systeme</li>
        <li><strong>Glänzen ohne zu Blenden</strong></li>
      </ul>
    </article>
    <article id="barrierefreiheit">
      <h1>Erreichen</h1>
      <p>
        <strong>Webseiten für Alle!</strong><br />
        Zugänglichkeit ist wichtig: für große Firmen per Gesetz und kleine Firmen
        profitieren von guter Usability und ein starkes Statement zur Inklusion mit
        verbessertem Ranking.
      </p>
      <ul class="stack-half">
        <li>Accessibility-Tests</li>
        <li>Verständliche Texte</li>
        <li>Webstandards und Accessibility</li>
        <li><strong>Einfach ist besser</strong></li>
      </ul>
    </article>
    <article>
      <h1>Sicherheit</h1>
      <p>
        <strong>Meine Daten sind meins!</strong><br />
        DSGVO, Tracking, Cookies - diese Begriffe lösen Unsicherheit aus. Ich steigere
        mit Focus auf europäische Datensouveränität Sicherheitsgefühl und Markenwert.
      </p>
      <ul class="stack-half">
        <li>WordPress, Astro, HTML und CSS</li>
        <li>Souveränes Hosting in Europa</li>
        <li>Systemberatung - Was brauche ich?</li>
        <li>
          <strong>Keine Baukästen oder Vendor Lock-in</strong>
        </li>
      </ul>
    </article>
  </section><section id="kause">
    <h1>Warum mit mir Arbeiten?</h1>
    <div class="grid">
      <ul class="stack-half">
        <li>keine Buzzwords</li>
        <li>kein Fachjargon</li>
        <li>interdisziplinare Erfahrung</li><li>voller Focus aufs Projekt</li>
      </ul>
      <p>
        Neben Expertise als Webentwickler und UX-Designer bringe ich Erfahrung
        aus über 25 Jahren Selbständigkeit als Fotografenmeister mit.<br />
        Als Entwickler und Fotograf denke ich von Anfang an Ästhetik, Technik, SEO
        und Accessibility zusammen.
      </p>
      <div>
        <CTA />
      </div>
    </div>
  </section>
</LandingPageLayout>
<script>
  import { initMovingCells } from '../scripts/moving-cells'
  const container = document.getElementById('wobble')
  if (container) initMovingCells(container)
</script>

<style>
  #wobble {
    width: 100%;
    aspect-ratio: 1;
    flex-shrink: 0;
    align-self: center;
  }

  #wobble img {
    display: none;
  }

  #wobble canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  textarea {
    resize: vertical;
  }
  #kause > h1 {
    display: block;
  }
</style>
