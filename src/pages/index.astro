---
import { Image } from 'astro:assets'
import daniel from '../assets/Daniel_Kause-Fotograf-1000px.jpg'
import BaseLayout from '../layouts/BaseLayout.astro'
import CTA from '../components/CTA.astro'
import Testimonial from '../components/testimonial.astro'
import { getCollection } from 'astro:content'

const testimonials = await getCollection('testimonials')
const davidTestimonial = testimonials.find((t) => t.id === 'david-hamann')
---

<BaseLayout
  title="Daniel Kause - Webentwicklung und UX Design | Silberblick"
  description="Schnelle, barrierefreie Webseiten, die von Suchmaschinen gefunden werden und Ihnen helfen, Kunden zu gewinnen. Von Daniel Kause, Fotografenmeister, UX Designer und Entwickler."
>
  <section class="grid">
    <div>
      <h1>SILBERBLICK<br /> <span style="font-size: 0.5em;">Klären. Entwickeln. Veredeln.</span></h1>

      <p>
        Ich bin Daniel Kause – Fotografenmeister, UX-Designer und Full-Stack-Entwickler. Ich baue Webseiten und
        Designsysteme für Firmen, Solo-Selbständige und Organisationen.<br /><strong>
          Ästhetisch, barrierefrei und sicher.
        </strong>
      </p>
      <CTA />
    </div>
    <div id="wobble" data-src={daniel.src}>
      <Image src={daniel} alt="Daniel Kause, Fotograf und Webentwickler" />
    </div>
  </section>
  <section id="Kunden">
    <h2>Wie helfe ich meinen Kunden bessere Webseiten zu bauen?</h2>
    <p>
      25 Jahre Fotografie haben meinen Blick geschult: fürs kleine Detail und das ganze Bild. Beides bringe ich in die
      Webentwicklung mit.<br />Jedes Produkt, jedes Business, jede Webseite hat einen Kern. Ich sorge dafür, dass man
      ihn sieht.
    </p>
  </section>
  <section class="grid" id="methode">
    <article>
      <h3>Klären</h3><p>
        Erst sehen, dann verstehen. Bevor ich eine Zeile Code schreibe, spreche ich mit den Menschen, für die die Seite
        gedacht ist. Das geht auch mit kleiner Nutzerbasis.<a href="/webseiten/wie-wir-webseiten-bauen">
          Wie, zeige ich am Beispiel von Dr. Hamann.</a>
        >
      </p>
    </article>
    <article>
      <h3>Entwickeln</h3><p>
        Nicht jeder Schuss sitzt sofort. Wie mit Polaroids früher, prüfe ich mit Prototypen und Tests die Umsetzung der
        Webseite oder App und justiere nach, bevor es teuer wird. Barrierefreiheit und Suchmaschinen-Optimierung denke
        ich vom Anfang an mit.
      </p>
    </article>
    <article>
      <h3>Veredeln</h3>
      <p>
        Weniger ist besser, meistens. Aus 25 Jahren Fotografie weiß ich, was ins Bild gehört und was nicht. Aus meiner
        Selbständigkeit weiß ich, was ein Projekt braucht, damit es im Rahmen bleibt: im Budget, im Zeitplan, im Blick.
      </p>
    </article>
  </section>
  <CTA />
</BaseLayout>
<script>
  import { initMovingCells } from '../scripts/moving-cells'

  let instance: ReturnType<typeof initMovingCells> | null = null

  function setup() {
    if (instance) instance.destroy()
    const container = document.getElementById('wobble')
    if (!container) return
    const img = container.querySelector('img')
    const altText = img?.getAttribute('alt') ?? ''
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      container.classList.add('static')
      container.removeAttribute('role')
      container.removeAttribute('aria-label')
      return
    }
    container.setAttribute('role', 'img')
    container.setAttribute('aria-label', altText)
    instance = initMovingCells(container)
  }
  function cleanup() {
    if (instance) {
      instance.destroy()
      instance = null
    }
  }
  document.addEventListener('astro:page-load', setup)
  document.addEventListener('astro:before-swap', cleanup)
</script>

<style>
  #wobble {
    max-width: min(100%, 500px);
    aspect-ratio: 1;
    flex-shrink: 0;
    align-self: flex-start;
  }

  #wobble img {
    display: none;
  }

  #wobble.static img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #wobble canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
