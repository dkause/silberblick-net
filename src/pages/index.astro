---
import { Image } from 'astro:assets'
import daniel from '../assets/Daniel_Kause-Fotograf-1000px.jpg'
import BaseLayout from '../layouts/BaseLayout.astro'
import CTA from '../components/CTA.astro'
import Testimonial from '../components/testimonial.astro'
import { getCollection } from 'astro:content'

const testimonials = await getCollection('testimonials')
const davidTestimonial = testimonials.find((t) => t.id === 'david-hamann')
---

<BaseLayout
  title="Daniel Kause - Webentwicklung und UX Design | Silberblick "
  description="Webseiten, schnell und barrierefrei, die von Suchmaschinen gefunden und Ihnen Kunden bringen"
>
  <section class="grid">
    <div>
      <h1>SILBERBLICK<br /> <span style="font-size: 0.5em;">Klären. Entwickeln. Veredeln.</span></h1>

      <p>
        Ich bin Daniel Kause – Fotografenmeister, UX-Designer und Full-Stack-Entwickler. Ich fotografiere und baue
        Webseiten und Designsysteme für Firmen, Solo-Selbstständige und Organisationen.<br /><strong>
          Ästhetisch, barrierefrei und sicher.
        </strong>
      </p>
      <CTA />
      <p>
        Zu meinen Kunden gehören Einzelunternehmer, wie der Historiker David Hamann, für den ich eine WordPress Webseite
        mit eigenem Template entwickelt habe. Oder die SMartde eG, deren WordPress Webseite ich mit kleinen Fixes,
        Plugin-Updates, Sicherheits- und Barrierefreiheitsaudits warte.
      </p>
    </div>
    <div id="wobble" data-src={daniel.src}>
      <Image src={daniel} alt="Daniel Kause, Fotograf und Webentwickler" />
    </div>
  </section>
  <section id="methode">
    <h2>Meine Methode</h2>
    <p>
      Meine 25 Jahre Erfahrung als der Fotograf von dem Fotostudio SILBERBLICK kommen mir als Webentwickler zugute. Wie
      ein Foto entsteht eine Website in mehreren Schritten, im Prozess.
    </p>
    <article>
      <h3>Klären</h3><p>
        Erst sehen,dann verstehen. Was gehört ins Bild und was nicht? Als UX Designer stelle ich den Menschen in den
        Mittelpunkt. Ich frage die Nutzer bevor ich mit der Entwicklung beginne. Wie das mit einer kleine Nutzerbasis
        gelingt, <a href="/referenzen/recherche-dienste"> ich am Beispiel von Dr. Hamann.</a>
      </p>
    </article>
    <article>
      <h3>Entwickeln</h3><p>
        Nicht jeder Schuss sitzt sofort. mit Prototypen und Tests prüfen wir die Umsetzung der Webseite oder App.
      </p>
    </article>
    <article>
      <h3>Veredeln</h3>
      <p>
        ?Retusche/das Bild muss in den Rahmen passen. Was funktioniert kommt in den Rahmen. Mit Accessiblity- und
        Seo-Checks bringe wir die Webseit online.
      </p>
    </article>
    <section>
      <h3>Über mich</h3>
      <p>
        Ich bringe Erfahrung aus über 25 Jahren Selbständigkeit als Fotografenmeister im eigenen Studio mit, inkl.
        Ausbildung einer Fotografin und einer Insolvenz in Eigenverwaltung durchgeführt.
      </p>
    </section>
    <div>
      <CTA />
    </div>
  </section>
</BaseLayout>
<script>
  import { initMovingCells } from '../scripts/moving-cells'

  let instance: ReturnType<typeof initMovingCells> | null = null

  function setup() {
    if (instance) instance.destroy()
    const container = document.getElementById('wobble')
    if (!container) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      container.classList.add('static')
      return
    }
    instance = initMovingCells(container)
  }
  function cleanup() {
    if (instance) {
      instance.destroy()
      instance = null
    }
  }
  document.addEventListener('astro:page-load', setup)
  document.addEventListener('astro:before-swap', cleanup)
</script>

<style>
  #wobble {
    max-width: min(100%, 500px);
    aspect-ratio: 1;
    flex-shrink: 0;
    align-self: flex-start;
  }

  #wobble img {
    display: none;
  }

  #wobble.static img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #wobble canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
