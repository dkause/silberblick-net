---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/LandingPageLayout.astro'
import Logo from '../components/logo.astro'
import daniel from '../assets/Daniel_Kause-Fotograf-1000px.jpg'
import LandingPageLayout from '../layouts/LandingPageLayout.astro'
---

<LandingPageLayout title="Daniel Kause">
  <Logo />
  <section class="grid">
    <div id="wobble" data-src={daniel.src} style="max-width:min(80%,20rem)">
      <Image src={daniel} alt="Portraitfoto Daniel Kause" />
    </div>
    <article>
      <h1>Fotografie und Webseiten aus einer Hand</h1><p>
        Daniel Kause fotografiert und baut Webseiten
      </p>
    </article>
  </section>
</LandingPageLayout>
<script>
  import { initMovingCells } from '../scripts/moving-cells'
  const container = document.getElementById('wobble')
  if (container) initMovingCells(container)
</script>

<style>
  #wobble {
    width: 100%;
    aspect-ratio: 1;
  }

  #wobble img {
    display: none;
  }

  #wobble canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  textarea {
    resize: vertical;
  }
</style>
