---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Projekt anfragen"
  description="Beschreiben Sie Ihr Projekt in ein, zwei Sätzen. Ich melde mich zurück."
>
  <h1>Skizzieren Sie mir Ihr Projekt</h1>
  <p>
    Ich antworte in der Regel innerhalb von ein bis zwei Tagen. Hinterlassen Sie
    am Telefon unbedingt eine kurze Nachricht, nur dann rufe ich zurück.<br />
    <strong>Ziel: </strong>Ich verschaffe mir einen Überblick und wir klären
    Details im Dialog.
  </p>
  <main>
    <form
      id="send-form"
      action="../send_mail.php"
      method="POST"
      aria-labelledby="contact-heading"
    >
      <fieldset>
        <legend id="contact-heading">Bitte Ausfüllen:</legend>
        <input
          type="tel"
          name="fax"
          id="fax"
          aria-disabled="true"
          aria-hidden="true"
          tabindex="-1"
          style="display:none"
        />
        <input id="form-time" type="hidden" name="form-time" />

        <label for="email">E-Mail:</label>
        <div id="email-hint">z.B. mensch.meier@meier-gmbh.de</div>
        <input
          type="email"
          id="email"
          name="email"
          required=""
          aria-required="true"
          aria-describedby="email-hint"
        />

        <label for="message">Nachricht</label>

        <div id="message-hint">
          Beschreiben Sie Projekt oder Problem - Ihren Namen und URL nicht
          vergessen. <strong>Details klären wir im Dialog.</strong>
        </div>
        <textarea
          id="message"
          name="message"
          rows="6"
          required=""
          aria-required="true"
          aria-describedby="message-hint"></textarea>

        <button
          class="button"
          type="submit"
          id="send-button"
          aria-describedby="submit-hint">Nachricht senden</button
        >

        <div id="submit-hint"></div>
        <div role="status" id="send-status" style="display: none"></div>
      </fieldset>
    </form>
  </main>
  <script>
    fetch('../get_time.php')
      .then((r) => r.text())
      .then((t) => {
        document.getElementById('form-time').value = t
      })
    const form = document.getElementById('send-form')
    const submitButton = document.getElementById('send-button')
    const sendstatus = document.getElementById('send-status')

    form?.addEventListener('submit', async (e) => {
      e.preventDefault()

      const formData = new FormData(form)
      const data = Object.fromEntries(formData)

      submitButton.disabled = true
      submitButton.textContent = 'Sende ...'
      sendstatus.style.display = 'block'
      sendstatus.style.color = ''
      sendstatus.innerHTML = '<p>Sende ...</p>'

      try {
        const response = await fetch('../send_mail.php', {
          method: 'POST',
          body: formData,
        })

        const result = await response.text()
        if (response.ok) {
          sendstatus.style.color = 'green'
          sendstatus.innerHTML = `<p><strong>Erfolgreich</strong> - Ich melde mich bald bei Ihnen.</p>`
          form.reset()
        } else {
          sendstatus.style.color = 'red'
          sendstatus.textContent = result || 'Ein Fehler ist aufgetreten'
        }
      } catch (error) {
        sendstatus.style.color = 'red'
        sendstatus.textContent = 'Netzwerkfehler. Bitte prüfe deine Verbindung.'
      } finally {
        submitButton.disabled = false
        submitButton.textContent = 'Nachricht senden'
      }
    })
  </script>
</BaseLayout>
