---
import { Image } from 'astro:assets'
import BaseLayout from '../../layouts/BaseLayout.astro'
import CTA from '../../components/CTA.astro'
import responsiveFlow from '../../assets/recherche-dienste-de.webp'
import cardSort from '../../assets/CardSorting-1.gif'
import treeResults from '../../assets/recherche-dienste_block-results_tree-1024x379.jpg'
import david from '../../assets/Foto-David-Hamann.jpg'
import Testimonial from '../../components/testimonial.astro'
---

<BaseLayout
  title="Relaunch WordPress Webseite Recherche-Dienste.de"
  description="Relaunch und Redesign WordPress für Dr David Hamann - Recherche Dienste"
>
  <article>
    <h1>Recherche-Dienste</h1>
    <p>
      Mit dem Historiker Dr. David Hamann habe ich die Website neu aufgesetzt - von der Informationsarchitektur bis zur
      Technik.
    </p>
    <figure>
      <Image src={responsiveFlow} alt={'responsives WordPress-Template'} />
      <figcaption>
        Passt sich an die Monitorgröße an: eigenes responsives WordPress-Template für Dr. David Hamann.
      </figcaption>
    </figure>
    <hr />
    <section class="gridx">
      <h2>Probleme</h2>
      <ul>
        <li>Die Website war nicht erreichbar</li>
        <li>Die WordPress-Basis veraltet</li>
        <li>Das Template war mobil kaum nutzbar</li>
        <li>WordPress ist nur Feature, kein Service des Hosters</li>
      </ul>
    </section>
    <hr />
    <section class="gridx">
      <h2>User Research</h2><section>
        <p>
          Vor Technik und Inhalt haben wir mit zehn Personen Card Sort und Tree Testing durchgeführt. <br />
        </p>
        <Image src={cardSort} alt="Card Sort für den WordPress Relaunch der Webseite Recherche-Dienste.de" />
        <p>Der Card Sort zeigt uns wie die Nutzer unsere Begriffe und Kategorien gruppieren.</p>
        <Image src={treeResults} alt="Ergebnisse eines Tree Testing für die Webseite Recherche-Dienste.de" />
        <p>Tree Testing: Wege zu den Inhalten.</p>
        <p>
          Die User Research liefert uns passende Labels, Kategorien und Navigationsstrukturen, diese bauen wir in die
          Informationsarchitektur ein.
        </p>
      </section>
    </section>
    <hr />
    <section class="gridx">
      <h2>Design</h2>
      <ul>
        <li>Zielgruppe 55+, Desktop-first</li>
        <li>Layout: textorientiert, Magazin-Stil</li>
        <li>klassische Sidebar, die mobil ausgeblendet wird</li>
        <li>ruhige Typografie und Farbpalette (Ocker/Sepia) kommunizieren Fachgebiet</li>
        <li>klare Gliederung</li>
      </ul>
    </section>
    <hr />
    <section class="gridx">
      <h2>Ergebnis</h2>
      <div>
        <p>
          Schon online und noch bevor alle Inhalte mehrsprachig eingepflegt sind, generiert die Webseite Leads aus
          Japan.
          <br />Das Design ist zugänglich, barrierefrei und schafft Vertrauen.<br />
          David pflegt und erweitert Inhalte selbstständig, ohne große Einarbeitungszeit.
        </p>
        <Testimonial
          title="Recherche Dienste"
          blockquote="Die neue Homepage ist ein Segen. Binnen kürzester Zeit hat sie große internationale Resonanz erzielt und die Anzahl der Anfragen hat sich mehr als verdoppelt."
          cite="Dr. David Hamann - Recherche-Dienste"
          image={david}
          imageAlt="Portrait Dr. David Hamann"
        />
      </div>
      <CTA />
    </section>
  </article>
</BaseLayout>
<style>
  .gridx {
    display: flex;
    flex-wrap: wrap;
    gap: 4rem;
  }
  .gridx > h2 {
    flex: 1 1 12rem;
  }

  .gridx > ul,
  .gridx > section {
    flex: 2 1 30rem;
  }
</style>
