---
const currentPath = Astro.url.pathname

const links = [
  { href: '/webseiten/wie-wir-webseiten-bauen', label: 'Was ich mache' },
  { href: '/ueber-mich', label: 'Warum Daniel' },
  { href: '/referenzen', label: 'Referenzen' },
  { href: '/kontakt', label: 'Kontakt' },
]
---

<nav aria-label="Hauptnavigation">
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 735px) {
    nav ul {
      flex-wrap: nowrap;
    }
  }

  nav a {
    letter-spacing: 0.12em;
    min-height: 44px;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--silver);
  }
</style>
