---
const { title, description } = Astro.props
import { ClientRouter } from 'astro:transitions'
// Person Schema Daniel
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://silberblick.net/#person',
  name: 'Daniel Kause',
  url: 'https://silberblick.net',
  jobTitle: 'Web Developer & UX Designer',
  sameAs: [
    'https://silberblick.berlin',
    'https://maps.app.goo.gl/4RY8EiGGve2Hw3948',
    'https://de.linkedin.com/in/kause',
  ],
}
// Business Schema SILBERBLICK
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://silberblick.net/#business',
  name: 'SILBERBLICK',
  url: 'https://silberblick.net/',
  telephone: '+491605535613',
  areaServed: { '@type': 'City', name: 'Berlin' },
  foundingDate: '2003',
  founder: { '@id': 'https://silberblick.net/#person' },
  sameAs: [
    'https://silberblick.berlin',
    'https://maps.app.goo.gl/4RY8EiGGve2Hw3948',
    'https://de.linkedin.com/in/kause',
  ],
}
---

<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
  <ClientRouter />
  <title>{title || 'Silberblick'}</title>
  <!-- Matomo Tag Manager -->
  <script>
    var _mtm = (window._mtm = window._mtm || [])
    _mtm.push({ 'mtm.startTime': new Date().getTime(), event: 'mtm.Start' })
    ;(function () {
      var d = document,
        g = d.createElement('script'),
        s = d.getElementsByTagName('script')[0]
      g.async = true
      g.src = 'https://analytics.silberblick.net/js/container_ri35N2sp.js'
      s.parentNode.insertBefore(g, s)
    })()
  </script>
  <!-- End Matomo Tag Manager -->
</head>
