---
import { Image } from 'astro:assets'
const { title, blockquote, cite, image, imageAlt } = Astro.props
---

<article class="testimonial">
  <Image src={image} alt={imageAlt} loading="eager" style="width: 9rem;" />
  <div>
    <h3>{title}</h3>
    <blockquote>
      <p>
        {blockquote}
      </p>
    </blockquote>
    <cite>{cite}</cite>
  </div>
</article>
