---
const { title, blockquote, cite, image, imageAlt } = Astro.props
---

<article class="testimonial">
  <img src={image.src} alt="{imageAlt}" style="width: 9rem;" />
  <div>
    <h3>{title}</h3>
    <blockquote>
      <p>
        {blockquote}
      </p>
    </blockquote>
    <cite>{cite}</cite>
  </div>
</article>
