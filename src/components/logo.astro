---
import logoSvg from '../assets/silberblick.svg?raw'

const logo = logoSvg.replace(/^<\?xml[^>]*\?>/, '').replace(/<!--.*?-->/s, '')
---

<div class="logo">
  <a href="/" aria-label="Silberblick – zur Startseite" set:html={logo} />
</div>

<style>
  .logo {
    width: 100%;
  }

  .logo a {
    display: block;
    text-decoration: none;
  }

  .logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .logo :global(svg text) {
    font-family: var(--font-sans);
    fill: currentColor;
  }

  @media (min-width: 735px) {
    .logo {
      width: 50%;
    }
  }
</style>
