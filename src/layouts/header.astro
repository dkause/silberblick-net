---
import Logo from '../components/logo.astro'
import Navigation from '../components/navigation.astro'
---

<header class="bite">
  <button
    onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true')"
    aria-expanded="false"
    aria-controls="hauptnavigation"
    aria-label="Menü"
    class="menu-button"
  >
    <svg focusable="false" viewBox="0 0 32 32" height="1em" style="vertical-align: middle;">
      <path d="M3 6h26 M3 16h26 M3 26h26" stroke="currentColor" stroke-width="3"></path>
    </svg>
  </button>
  <Logo />
  <Navigation />
</header>

<style>
  .bite {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    width: 100%;
    hyphens: manual;
    color: var(--silver);
    background-color: var(--dark);
    padding: 0.75rem;
  }

  .bite::after {
    --bite-size: 20px;

    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: var(--bite-size);
    height: var(--bite-size);
    border-right: var(--bite-size) solid var(--light);
    border-bottom: var(--bite-size) solid var(--light);
  }

  .menu-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    background-color: var(--dark);
    border: none;
    color: var(--silver);
    font-weight: bolder;
    font-size: calc(var(--font-size) * 1.25);
    padding: 0.75em;
    gap: 0.25em;
    margin-right: 1rem;
  }

  header > nav {
    flex-basis: 100%;
    display: none;
  }

  [aria-expanded='true'] ~ nav {
    display: flex;
    gap: var(--space);
    padding: var(--space);
  }

  nav > h2 {
    border: none;
    padding-block-end: 0;
  }

  nav h2 {
    font-size: var(--font-size);
    text-transform: uppercase;
    font-weight: 800;
  }

  nav ul {
    display: inline-block;
    list-style: none;
    padding: 0;
    margin-block: 1em;
  }

  nav a,
  header a {
    letter-spacing: 0.12em;
    transform: none;
    min-height: 44px;
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--silver);
  }
</style>
