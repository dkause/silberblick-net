---
import Logo from '../components/logo.astro'
import Navigation from '../components/navigation.astro'
---

<header class="header-container bite">
  <Navigation />
  <Logo />
</header>

<style>
  .header-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    hyphens: manual;
    color: var(--silver);
    background-color: var(--dark);
    padding: 0.75rem;
  }

  .bite::after {
    --bite-size: 20px;

    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: var(--bite-size);
    height: var(--bite-size);
    border-right: var(--bite-size) solid var(--bg-color);
    border-bottom: var(--bite-size) solid var(--bg-color);
  }
</style>
