---
import Logo from '../components/logo.astro'
import Navigation from '../components/navigation.astro'
---

<header class="header-container bite">
  <div class="header-inner">
    <Logo />
    <hr />
    <Navigation />
  </div>
</header>

<style>
  .header-inner {
    width: 100%;
    max-inline-size: 1180px;
    margin-inline: auto;
    padding-inline: clamp(0.5rem, 1rem + 1vw, 2rem);
    padding-block: var(--space-m);
  }

  .header-container {
    position: relative;
    width: 100%;
    hyphens: manual;
    color: var(--silver);
    background-color: var(--dark);
  }

  hr {
    width: 100%;
    margin-block: var(--space-m);
    border: 0;
    border-block-start: 1px solid var(--silver);
  }

  .bite::after {
    --bite-size: 20px;

    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: var(--bite-size);
    height: var(--bite-size);
    border-right: var(--bite-size) solid var(--bg-color);
    border-bottom: var(--bite-size) solid var(--bg-color);
  }
</style>
